<launch>
        <node pkg="turtlesim" exec="turtlesim_node"
            args="--ros-args --log-level fatal" />
    <node pkg="turtlesim_catch_them_all" exec="manual_controller" output="screen" emulate_tty="true">
        <param from="$(find-pkg-share my_bringup)/config/catch_them_all_config.yaml" />
    </node>
    <node pkg="turtlesim_catch_them_all" exec="spawner" output="screen">
        <param from="$(find-pkg-share my_bringup)/config/catch_them_all_config.yaml" />
        <param name="log_spawned_turtles" value="false" />
    </node>
</launch>
